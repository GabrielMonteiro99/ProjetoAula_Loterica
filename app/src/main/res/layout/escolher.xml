<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#005CA9"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="142dp"
        android:layout_height="88dp"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/trevo3" >

    <Button
        android:id="@+id/button4"
        android:layout_width="150dp"
        android:layout_height="98dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="#F47920"
        android:text="Lotomania\n R$ 1,4 milhão"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toEndOf="@+id/button2"
        tools:layout_editor_absoluteY="389dp" />

    <Button
        android:id="@+id/button3"
        android:layout_width="150dp"
        android:layout_height="98dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="#4A148C"
        android:text="Loto fácil\n R$ 5 milhões"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:strokeColor="@color/black"
        tools:layout_editor_absoluteY="292dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="150dp"
        android:layout_height="98dp"
        android:layout_marginStart="52dp"
        android:backgroundTint="#4A1A6D"
        android:text="Quina\n R$ 9,2 milhões"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="389dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="150dp"
        android:layout_height="98dp"
        android:layout_marginStart="52dp"
        android:backgroundTint="@android:color/holo_green_light"
        android:strokecolor="app:strokeColor"
        android:text="Mega-Sena\n R$ 30 milhões."
        android:textColorLink="#4CAF50"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="292dp" />

    <Button
        android:id="@+id/button5"
        android:layout_width="106dp"
        android:layout_height="39dp"
        android:backgroundTint="@color/white"
        android:text="Encerrar"
        android:textColor="@color/black"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="@+id/button4"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="@+id/button4"
        tools:layout_editor_absoluteY="522dp" />

    <Button
        android:id="@+id/button7"
        android:layout_width="106dp"
        android:layout_height="39dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/white"
        android:text="Voltar"
        android:textColor="@color/black"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="@+id/button2"
        tools:layout_editor_absoluteY="522dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loterias online"
        android:textColor="@color/black"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="144dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jogos proibidos para menores de 18 anos. Jogue com responsabilidade."
        android:textColor="#0B132B"
        android:textSize="10dp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="52dp"
        tools:layout_editor_absoluteY="715dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aposte quando e onde quiser\n   todos os jogos acumulam"
        android:textColor="#0B132B"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="209dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Todos os direitos reservados a Gabriel Monteiro"
        android:textAlignment="center"
        android:textColor="#B3000000"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="699dp" />

</androidx.constraintlayout.widget.ConstraintLayout>